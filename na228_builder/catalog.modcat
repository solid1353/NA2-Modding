type control_action = "attack" | "ultimate_jutsu_prep" | "item_use" | "jump" | "substitution" | "guard" | "item_select_l" | "item_select_r" | "linked_attack" | "unbound";
type com_difficulty = "simple" | "easy" | "normal" | "hard" | "insane" | "ultimate";

{
  features: {
    localization:
      setting<"en"> {
        description: "English text, font, UI, and matching button conventions.",
        patch: "localization.en",
      }
      |
      setting<"jp"> {
        description: "Japanese text, UI, and button conventions. Experimental; some custom graphics and controls do not work correctly.",
      },
    general: {
      description: "General game-wide features.",
      music_override: setting {
        patch: "general.music_override",
      },
      practice_stage_select: setting {
        description: "Choose a stage before Practice, with the training field selected initially.",
        patch: "general.practice_stage_select",
      },
      stage_selection_persistence: setting {
        description: "Restore the last highlighted stage when Free Battle or Practice Stage Select opens again during the current session.",
        patch: "general.stage_selection_persistence",
      },
      battle_results_rematch: setting {
        description: "Add Circle Rematch to Battle Results and retain the matchup and session match score.",
        patch: "general.battle_results_rematch",
      },
      unlock_all: {
        description: "Expose the characters, supports, stages, jutsu, Shop items, and Collection entries present in a fully unlocked save without changing saved progress, currency, inventory, or settings.",
        patch: "general.unlock_all",
        demon_wind_bomb: setting<bool> {},
      } | false,
      mode_availability: {
        description: "Configure which game modes are available.",
        remove_adventure: setting {
          patch: "general.mode_availability.remove_adventure",
        },
        remove_shop: setting {
          patch: "general.mode_availability.remove_shop",
        },
      } | false,
    } | false,
    startup: {
      description: "Skip the intro movies and title screen, then continue to save loading.",
      patch: "startup",
      faster_loading: setting {
        description: "Shorten startup by delaying voice setup until the voices are first needed.",
        patch: "startup.faster_loading",
      },
      loading_screen: setting {
        description: "Show NA2.28 artwork with a short white loading bar beneath its title. The bar estimates progress; the game continues when loading finishes.",
        patch: "startup.loading_screen",
      },
    } | false,
    memory_card: {
      description: "Memory-card save storage and save-menu appearance.",
      auto_loading: setting {
        description: "Automatically load the first save and use only that slot for saving and loading. Show the load result in the main menu. Disable to load manually and choose among all save slots. Manual loading works, but it is not fully supported or tested.",
        patch: "memory_card.auto_loading",
      },
      dialogs_rework: setting {
        description: "Streamline memory-card confirmations and close declined dialogs with the normal shrinking animation.",
        patch: "memory_card.dialogs_rework",
      },
      skip_initial_check: setting {
        description: "Skip the early memory-card check at startup. Automatic save loading is controlled separately.",
        patch: "memory_card.skip_initial_check",
      },
      extended_save_data: setting {
        patch: "memory_card.extended_save_data",
      },
    } | false,
    rendering: {
      description: "Screen proportions and display settings.",
      native_16_9_horizontal_scale: setting {
        description: "Apply basic horizontal scaling for a 16:9 display. Experimental: the interface does not scale properly.",
        patch: "rendering.native_16_9_horizontal_scale",
      },
    } | false,
    defaults: {
      description: "Set initial values and Return to Defaults values for in-game options. Loaded save settings override initial values.",
      patch: "defaults",
      mod_settings: {
        description: "Configure the options available in the in-game Mod Settings menu.",
        patch: "defaults.mod_settings",
        match_setup_submenu: setting {},
        battle_mechanics_submenu: setting {},
        battle_settings_submenu: setting {},
        practice_settings_submenu: setting {},
        control_settings_submenu: setting {},
        simple_display: setting<"off" | "on"> {
          patch: "defaults.mod_settings.simple_display",
        },
      },
      match_setup: {
        support_selection: setting<"none" | "relevant" | "all"> {
          description: "Control which supports are available during Character Select.",
          patch: "defaults.match_setup.support_selection",
        },
        character_balance: setting<"original" | "overrides"> {
          description: "Choose between original character balance and the configured balance changes.",
          patch: "defaults.match_setup.character_balance",
        },
        balance_overlay: setting<"off" | "on"> {
          description: "Show character balance information on Character Select.",
          patch: "defaults.match_setup.balance_overlay",
        },
        extended_items: setting<"off" | "on"> {
          description: "Enable five battle-item slots instead of the native three.",
          patch: "defaults.match_setup.extended_items",
        },
      },
      battle_mechanics: {
        chakra: setting<"normal" | "unlimited" | decimal & 0.1..10 & step 0.1> {
          patch: "defaults.battle_mechanics.chakra",
        },
        ultimate_jutsu: setting<"no_use" | "random" | "command" | "timing" | "turn" | "combo" | "no_contest" | "no_hud"> {
          patch: "defaults.battle_mechanics.ultimate_jutsu",
        },
        shadowblur: setting<"off" | "on"> {
          patch: "defaults.battle_mechanics.shadowblur",
        },
        extra_hit: setting<"off" | "on" | int & -100..-5 & step 5> {
          patch: "defaults.battle_mechanics.extra_hit",
        },
        xdash_chakra_cost: setting<int & 0..100 & step 5> {
          patch: "defaults.battle_mechanics.xdash_chakra_cost",
        },
        support: setting<"off" | "nerfed" | "normal" | "unlimited"> {
          patch: "defaults.battle_mechanics.support",
        },
        substitution_input: setting<"default" | "hold" | int & 1..15> {
          patch: "defaults.battle_mechanics.substitution_input",
        },
        substitution_resource: setting<{
            value: "chakra" | "gauge" | "free",
            chakra?: {
              minimum_chakra?: "match_cost" | int & 5..100 & step 5,
            },
            gauge?: {
              recovery_delay_seconds?: decimal & 0..60 & step 0.25,
              refill_seconds_per_stock?: decimal & >0 & <=10 & step 0.05,
              damage_recovery?: "off" | "on",
              damage_percent_for_full_refill?: decimal & 5..400 & step 5,
            },
          }> {
          description: "Choose whether substitution uses chakra, uses a gauge, or is free, and configure gauge recovery.",
          patch: "defaults.battle_mechanics.substitution_resource",
        },
        items: setting<{
          value: "none" | "less" | "normal" | "more" | "custom",
          custom: {
            availability: "none" | "less" | "normal" | "more",
            health_recovery: "off" | "on",
            chakra_ball: "off" | "on",
            shoes_of_jonin: "off" | "on",
            food_pills: "off" | "on",
            scroll_of_hidden_cloud: "off" | "on",
            scroll_of_teleportation: "off" | "on",
            scarecrow: "off" | "on",
            tortoiseshell_pills: "off" | "on",
            energy_pills: "off" | "on",
            medical_pack: "off" | "on",
            item_pouch: "off" | "on",
            demon_wind_shuriken: "off" | "on",
            weight_of_determination: "off" | "on",
            exploding_kunai: "off" | "on",
            poison_smoke_bomb: "off" | "on",
            makibishi_spikes: "off" | "on",
            paper_bomb: "off" | "on",
            curse_tag_chakra_points_seal: "off" | "on",
            curse_tag_armor_break: "off" | "on",
            thousand_shadow_shuriken: "off" | "on",
            burst_kunai: "off" | "on",
            exploding_seal: "off" | "on",
            toad_oil: "off" | "on",
            random_ball: "off" | "on",
            stun_ball: "off" | "on",
          },
        }> {
          patch: "defaults.battle_mechanics.items",
        },
      },
      battle_settings: {
        battle_mechanics_submenu: setting {},
        time: setting<int & 10..90 & step 10 | 99 | "unlimited"> {},
        difficulty: setting<com_difficulty> {},
        handicap: setting<int & 0..10> {},
      },
      practice_settings: {
        battle_mechanics_submenu: setting {},
        opponent_settings: {
          status: setting<"manual" | "com" | "stand" | "jump" | "double_jump"> {},
          strength: setting<com_difficulty> {},
          attack: setting<"no" | "single" | "combo" | "projectile" | "high_speed_move" | "ultimate_jutsu" | "jutsu"> {},
          guard: setting<"no" | "yes"> {},
          move: setting<"stay" | "follow"> {},
          substitution_jutsu: setting<"normal" | "no"> {},
          linked_attack: setting<"dont_use" | "normal" | "random"> {},
          extra_hit_counter: setting<"normal" | "return"> {},
        },
        health: setting<"normal" | "half" | "almost"> {},
        commands: setting<"off" | "on"> {},
        damage: setting<"off" | "on"> {},
      },
      control_settings: {
        description: "Allow separate Guard and Substitution bindings, plus two Guard/Sub bindings, and set the default action for each button.",
        patch: "defaults.control_settings",
        circle: setting<control_action> {},
        triangle: setting<control_action> {},
        square: setting<control_action> {},
        cross: setting<control_action> {},
        select: setting<control_action> {},
        l1: setting<control_action> {},
        r1: setting<control_action> {},
        l2: setting<control_action> {},
        r2: setting<control_action> {},
        l3: setting<control_action> {},
        r3: setting<control_action> {},
        vibration: setting<"off" | "on"> {},
      },
    },
  },
}
