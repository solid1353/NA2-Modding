[+Disable modes]
patch=1,EE,005DC300,word,FFFFFFFF // Master mode
patch=1,EE,005DC310,word,FFFFFFFF // Shop

[+Skips]
patch=1,EE,001E4394,word,A785FDDC // Skip CC2 intro
patch=1,EE,001E440C,word,10000007 // Skip opening

[+Practice QoL]
// patch=1,EE,001ED8D8,word,A0850001 // Half HP: sb a1,1(a0)
patch=1,EE,001ED920,word,00000000 // Voice off
patch=1,EE,001ED96C,word,A080000B // Support off
patch=1,EE,001ED884,word,00000000 // Command display off
patch=1,EE,001ED89C,word,00000000 // Simple display off

[+Default save overwrite confirmation to Yes]
patch=1,EE,001EB18C,word,AC400014

[+Match NA228 automatic startup flow]
// Select English and complete the only call to the language selector immediately.
patch=1,EE,003D0C60,word,3C020061 // lui v0,0x61
patch=1,EE,003D0C64,word,AC401C10 // sw zero,0x1c10(v0)
patch=1,EE,003D0C68,word,24020001 // li v0,1
patch=1,EE,003D0C6C,word,03E00008 // jr ra
patch=1,EE,003D0C70,word,00000000 // nop

// Suppress the remaining logo sequence after the normal English text load.
patch=1,EE,001E6620,word,00000000 // nop the branch into logo playback

// Enter the title state after required startup loaders, select Continue, map every
// no-load result to normal menu continuation, and suppress the Save/Load child draw.
patch=1,EE,001E6DB4,word,24030003 // li v1,3
patch=1,EE,001E6E28,word,24020002 // li v0,2
patch=1,EE,001EFEDC,word,0C0F4320 // jal 0x003d0c80
patch=1,EE,001EFEFC,word,0000102D // move v0,zero
patch=1,EE,001F0174,word,00000000 // nop

