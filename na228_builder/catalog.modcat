{
  features: {
    settings: {
      new_controls: setting {
        description: "Expose Guard and Substitution as independent remappable actions and default both players to L1 Substitution, R1 Guard, L2 Item Select, and R2 Linked Attack.",
        patch: "settings.new_controls",
      },
      simple_display: setting<"off" | "on"> {
        patch: "settings.simple_display",
      },
      character_overrides: setting {
        description: "Load layered per-character battle overrides.",
        patch: "settings.character_overrides",
      },
      ingame: {
        description: "Configure which options are available in the Battle and Practice Settings menus and their default values.",
        patch: "settings.ingame",
        battle_mode: {
          battle_mechanics: setting {},
          time: setting<int & 10..90 & step 10 | 99 | "unlimited"> {},
          difficulty: setting<"simple" | "easy" | "normal" | "hard" | "insane" | "ultimate"> {},
          handicap: setting<int & 0..10> {},
        },
        practice_mode: {
          battle_mechanics: setting {},
          opponent_settings: {
            status: setting<"manual" | "com" | "stand" | "jump" | "double_jump"> {},
            strength: setting<"simple" | "easy" | "normal" | "hard" | "insane" | "ultimate"> {},
            attack: setting<"no" | "single" | "combo" | "projectile" | "high_speed_move" | "ultimate_jutsu" | "jutsu"> {},
            guard: setting<"no" | "yes"> {},
            move: setting<"stay" | "follow"> {},
            substitution_jutsu: setting<"normal" | "no"> {},
            linked_attack: setting<"dont_use" | "normal" | "random"> {},
            extra_hit_counter: setting<"normal" | "return"> {},
          },
          health: setting<"normal" | "half" | "almost"> {},
          commands: setting<"off" | "on"> {},
          damage: setting<"off" | "on"> {},
        },
        battle_mechanics: {
          chakra: setting<"normal" | "unlimited" | decimal & 0.1..10 & step 0.1> {
            patch: "settings.battle_mechanics.chakra",
          },
          ultimate_jutsu: setting<"no_use" | "random" | "command" | "timing" | "turn" | "combo" | "no_contest" | "no_hud"> {
            patch: "settings.battle_mechanics.ultimate_jutsu",
          },
          shadowblur: setting<"off" | "on"> {
            patch: "settings.battle_mechanics.shadowblur",
          },
          extra_hit: setting<"off" | "on" | int & -100..-5 & step 5> {
            patch: "settings.battle_mechanics.extra_hit",
          },
          sub_active_frames: setting<"default" | int & 1..15> {
            patch: "settings.battle_mechanics.sub_active_frames",
          },
          xdash_chakra_cost: setting<int & 0..100 & step 5> {
            patch: "settings.battle_mechanics.xdash_chakra_cost",
          },
          support: setting<"off" | "nerfed" | "normal" | "unlimited"> {
            patch: "settings.battle_mechanics.support",
          },
          substitution: setting<{
              value: "chakra" | "gauge" | "free",
              chakra?: {
                minimum_chakra?: "match_cost" | int & 5..100 & step 5,
              },
              gauge?: {
                recovery_delay_seconds?: decimal & 0..60 & step 0.25,
                refill_seconds_per_stock?: decimal & >0 & <=10 & step 0.05,
                damage_recovery?: bool,
                damage_percent_per_stock?: decimal & >0 & <=100 & step 0.25,
              },
            }> {
            description: "Configures substitution payment and gauge recovery.",
            patch: "settings.battle_mechanics.substitution",
          },
          items: setting<{
            value: "none" | "less" | "normal" | "more" | "custom",
            custom: {
              availability: "none" | "less" | "normal" | "more",
              health_recovery: bool,
              chakra_ball: bool,
              shoes_of_jonin: bool,
              food_pills: bool,
              scroll_of_hidden_cloud: bool,
              scroll_of_teleportation: bool,
              scarecrow: bool,
              tortoiseshell_pills: bool,
              energy_pills: bool,
              medical_pack: bool,
              item_pouch: bool,
              demon_wind_shuriken: bool,
              weight_of_determination: bool,
              exploding_kunai: bool,
              poison_smoke_bomb: bool,
              makibishi_spikes: bool,
              paper_bomb: bool,
              curse_tag_chakra_points_seal: bool,
              curse_tag_armor_break: bool,
              thousand_shadow_shuriken: bool,
              burst_kunai: bool,
              exploding_seal: bool,
              toad_oil: bool,
              random_ball: bool,
              stun_ball: bool,
            },
          }> {
            patch: "settings.battle_mechanics.items",
          },
        },
      },
    },
    general: {
      description: "General game-wide features.",
      unlock_all: setting<{ demon_wind_bomb?: bool }> {
        description: "Expose the characters, supports, stages, jutsu, Shop items, and Collection entries present in a fully unlocked save without changing saved progress, currency, inventory, or settings.",
        patch: "general.unlock_all",
      },
      replace_imported_game_title: setting {
        patch: "general.replace_imported_game_title",
      },
    },
    memory_card: {
      description: "Memory-card save presentation and isolation.",
      display_only_first_save: setting {
        description: "Select record zero directly in Save and Load flows while retaining the native memory-card scan, confirmation, load/save operations, and non-record status handling; No completes without reopening the removed record list.",
        patch: "memory_card.display_only_first_save",
      },
      dedicated_save_namespace: setting {
        patch: "memory_card.dedicated_save_namespace",
      },
      replace_memory_card_title: setting {
        patch: "memory_card.replace_memory_card_title",
      },
    },
    startup: {
      description: "After required loaders and boot splashes, skip the CyberConnect2 intro, opening, and interactive title, then enter native Save/Load.",
      patch: "startup",
      faster_loading: setting {
        description: "Shorten startup by loading RPG and player voice-bank indexes only when each bank is first played.",
        patch: "startup.faster_loading",
      },
      skip_initial_memory_card_check: setting {
        description: "Skip the blocking memory-card check before boot loading, independently of automatic save loading.",
        patch: "startup.skip_initial_memory_card_check",
      },
      auto_loading: setting {
        description: "Silently load record zero when it exists, and otherwise proceed to the main menu without showing Save/Load UI or requiring input. Report the outcome in black for ten seconds in the top-right corner of the usable menu; successful loads also show play time and the saved date/time.",
        patch: "startup.auto_loading",
      },
      loading_screen: setting {
        description: "Replace the boot splashes with a large primitive percentage and progress bar paced across a 6.5-second elapsed-time estimate while the original startup loaders run.",
        patch: "startup.loading_screen",
      },
    },
    character_select: {
      description: "Character Select behavior and overlays.",
      balance_overlay: setting {
        description: "Show each side's character tier on Character Select and include resolved substitution cost only when Character Overrides is enabled.",
        patch: "character_select.balance_overlay",
      },
      support_selection: setting<"all" | "relevant" | "none"> {
        description: "Control which supports are available during Character Select.",
        patch: "character_select.support_selection",
      },
    },
    mode_select: {
      description: "Configure which modes are available on Mode Select.",
      remove_adventure: setting {
        patch: "mode_select.remove_adventure",
      },
      remove_shop: setting {
        patch: "mode_select.remove_shop",
      },
    },
    rendering: {
      description: "Game-wide rendering and output geometry.",
      native_16_9_horizontal_scale: setting {
        description: "Force the renderer's horizontal-scale field to 0.75 through its object pointer.",
        patch: "rendering.native_16_9_horizontal_scale",
      },
    },
    localization: {
      description: "English localization and regional behavior.",
      patch: "localization",
      font: {
        description: "English font rendering and formatting.",
        glyphs: setting {
          description: "Use the English glyph atlas, packed metrics, and renderer geometry.",
          patch: "localization.font.glyphs",
        },
        layout: setting {
          description: "Apply English text measurement, fitting, wrapping, selected styling, and screen-specific layout.",
          patch: "localization.font.layout",
        },
        numeric_formatting: setting {
          description: "Format dynamic numbers with the English renderer conventions.",
          patch: "localization.font.numeric_formatting",
        },
      },
      ui: setting {
        description: "Apply matching English UI textures, rectangles, anchors, scaling, and screen-specific geometry.",
        patch: "localization.ui",
      },
      regional_input: setting {
        description: "Apply regional confirm, cancel, navigation, and related menu-input behavior consistently across the game.",
        patch: "localization.regional_input",
      },
      strings: setting {
        patch: "localization.strings",
      },
    },
  },
}
