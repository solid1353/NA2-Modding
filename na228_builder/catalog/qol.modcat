{
  startup: {
    faster_loading: setting {
      description: "Shorten startup by loading RPG and player voice-bank indexes only when each bank is first played.",
      patches: [
        "i__qol__startup__faster_loading__lazy_voice_indexes",
      ],
    },
    flow:
      {
        description: "Retain the native title path with independent optional skips for its preceding sequences.",
        skip_cc2_intro: setting {
          description: "Skip the CyberConnect2 intro.",
          patches: [
            "e__qol__startup__skip_cc2_intro__skip_cc2_intro",
          ],
        },
        skip_opening: setting {
          description: "Skip the opening sequence.",
          patches: [
            "e__qol__startup__skip_opening__skip_opening",
          ],
        },
      }
      |
      {
        description: "Replace the boot presentation and route directly through the startup Save/Load path.",
        savedata_loading:
          setting<"manual"> {
            description: "Retain the native visible Save/Load flow; no-load completion proceeds to the main menu.",
            patches: [
              "e__qol__startup__save_loading__enter_title_input_state_immediately",
              "e__qol__startup__save_loading__return_native_continue_result",
              "e__qol__startup__save_loading__treat_no_load_completion_as_menu_success",
            ],
          }
          |
          setting<"automatic"> {
            description: "Silently load record zero when it exists, and otherwise proceed to the main menu without showing Save/Load UI or requiring input. Report the outcome in black for ten seconds in the top-right corner of the usable menu; successful loads also show play time and the saved date/time.",
            patches: [
              "e__qol__startup__save_loading__enter_title_input_state_immediately",
              "e__qol__startup__save_loading__return_native_continue_result",
              "e__qol__startup__save_loading__treat_no_load_completion_as_menu_success",
              "e__qol__startup__save_loading__automatic__suppress_save_load_draw",
              "i__qol__startup__save_loading__automatic__first_save",
            ],
          },
        loading_screen: setting {
          description: "Replace the boot splashes with a large primitive percentage and progress bar paced across a 6.5-second elapsed-time estimate while the original startup loaders run.",
          patches: [
            "i__qol__startup__loading_screen__runtime",
          ],
        },
      },
  },
  practice: {
    description: "Independent Practice-mode default settings.",
    bootstrap: setting<{
      p1: int & 1..93,
      support: int & 0..37,
      awakening: "none" | (int & 0..137),
    }> {
      description: "Enter Practice directly after startup with the configured Player 1 character, support, and optional active awakening; Player 2, its support, and the Practice stage remain fixed.",
      patches: [
        "e__qol__practice__bootstrap__enter_practice_after_continue",
        "i__qol__practice__bootstrap__configured_battle",
      ],
    },
    starting_hp:
      setting<"full"> {
        description: "Start both Practice fighters at full HP.",
        patches: [
          "e__qol__practice__starting_hp__full",
        ],
      }
      |
      setting<"half"> {
        description: "Start both Practice fighters at half HP.",
        patches: [
          "e__qol__practice__starting_hp__half",
        ],
      }
      |
      setting<"critical"> {
        description: "Start both Practice fighters at critical HP.",
        patches: [
          "e__qol__practice__starting_hp__critical",
        ],
      },
    voice_off_by_default: setting {
      description: "Start Practice with voice disabled.",
      patches: [
        "e__qol__practice__voice_off_by_default__voice_off_by_default",
      ],
    },
    support_off_by_default: setting {
      description: "Start Practice with support disabled.",
      patches: [
        "e__qol__practice__support_off_by_default__force_instead_leaving_previous_settings",
      ],
    },
    command_display_off_by_default: setting {
      description: "Start Practice with command display disabled.",
      patches: [
        "e__qol__practice__command_display_off_by_default__force_preserving_following_settings_field",
      ],
    },
    simple_display_off: setting {
      description: "Simple-display default control.",
      patches: [
        "e__qol__practice__simple_display_off__by_default",
      ],
    },
  },
  character_select: {
    description: "Character Select support-list behavior.",
    no_support: setting {
      description: "Build compact per-character support lists with selectable No Support, retain selected supports for linked Jutsu, and disable free-field support calls and their gauge.",
      patches: [
        "i__qol__character_select__no_support__support_list",
      ],
    },
  },
  mode_select: {
    description: "Mode availability and selection behavior.",
    remove_adventure: setting {
      description: "Omit Adventure from Mode Select using the NUN6 negative availability sentinel.",
      patches: [
        "e__qol__mode_select__remove_adventure__mark_entry_unavailable_matching_nun6",
      ],
    },
    remove_shop: setting {
      description: "Omit Shop from Mode Select using the same negative availability sentinel as the Adventure omission.",
      patches: [
        "e__qol__mode_select__remove_shop__mark_entry_unavailable_using_existing",
      ],
    },
  },
  content: {
    description: "Runtime content availability independent of loaded save progress.",
    unlock_all: setting {
      description: "Expose the characters, supports, stages, jutsu, Shop items, and Collection entries present in a fully unlocked save without changing saved progress, currency, inventory, or settings.",
      patches: [
        "i__qol__content__unlock_all__availability",
      ],
    },
  },
  save_load: {
    description: "Save and load modal presentation.",
    display_only_first_save: setting {
      description: "Select record zero directly in Save and Load flows while retaining the native memory-card scan, confirmation, load/save operations, and non-record status handling; No completes without reopening the removed record list.",
      patches: [
        "e__qol__save_load__display_only_first_save__advance_status_0x0a_without_constructing",
        "e__qol__save_load__display_only_first_save__center_date_play_time_block",
        "e__qol__save_load__display_only_first_save__center_single_record_local_y",
        "e__qol__save_load__display_only_first_save__enter_sole_slot_path_before",
        "e__qol__save_load__display_only_first_save__exit_controller_when_final_confirmation",
        "e__qol__save_load__display_only_first_save__exit_controller_when_no_data",
        "e__qol__save_load__display_only_first_save__ignore_downward_slot_navigation_before",
        "e__qol__save_load__display_only_first_save__ignore_upward_slot_navigation_before",
        "e__qol__save_load__display_only_first_save__limit_shared_slot_row_renderer",
        "e__qol__save_load__display_only_first_save__move_redundant_slot_number_record",
        "e__qol__save_load__display_only_first_save__move_the_upper_panel_to_centered_x",
        "e__qol__save_load__display_only_first_save__move_upper_panel_detached_y",
        "e__qol__save_load__display_only_first_save__prepare_status_0x0a_modal_helper",
        "e__qol__save_load__display_only_first_save__retain_helper_s_zero_second",
        "e__qol__save_load__display_only_first_save__return_main_menu_when_unformatted",
        "e__qol__save_load__display_only_first_save__route_load_confirmation_no_to_completion",
        "e__qol__save_load__display_only_first_save__route_memory_card_status_dispatch",
        "e__qol__save_load__display_only_first_save__select_slot_zero_enter_its",
        "e__qol__save_load__display_only_first_save__shrink_the_upper_panel_height_from_224_to",
        "e__qol__save_load__display_only_first_save__shrink_the_upper_panel_width_from_400_to",
        "e__qol__save_load__display_only_first_save__skip_unformatted_card_informational_modal",
        "e__qol__save_load__display_only_first_save__suppress_obsolete_independent_slot_cursor",
        "e__qol__save_load__display_only_first_save__suppress_row_separators_when_one",
      ],
    },
  },
}
