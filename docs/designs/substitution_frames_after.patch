+/* Native EE adapter for the bounded post-impact substitution window. */
+    .set noreorder
+    .set noat
+
+    .section .text.battle_logic_substitution_update_ordinary_response,"ax",@progbits
+    .balign 4
+    .globl battle_logic_substitution_update_ordinary_response
