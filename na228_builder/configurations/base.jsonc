{
  "features": {
    "settings": {
      "new_controls": true,
      "simple_display": "off",                    // "off" | "on"
      "character_overrides": true,
      "ingame": {
        "battle_mode": {
          "battle_mechanics": true,
          "time": 99,                             // int 10..90 (step 10) | 99 | "unlimited"
          "difficulty": "ultimate",               // "simple" | "easy" | "normal" | "hard" | "insane" | "ultimate"
          "handicap": 0                           // int 0..10 (Player 1; Player 2 is 10 minus this value)
        },
        "practice_mode": {
          "battle_mechanics": true,
          "opponent_settings": {
            "status": "manual",                   // "manual" | "com" | "stand" | "jump" | "double_jump"
            "strength": "normal",                 // "simple" | "easy" | "normal" | "hard" | "insane" | "ultimate"
            "attack": "no",                       // "no" | "single" | "combo" | "projectile" | "high_speed_move" | "ultimate_jutsu" | "jutsu"
            "guard": "no",                        // "no" | "yes"
            "move": "stay",                       // "stay" | "follow"
            "substitution_jutsu": "normal",       // "normal" | "no"
            "linked_attack": "dont_use",          // "dont_use" | "normal" | "random"
            "extra_hit_counter": "normal"         // "normal" | "return"
          },
          "health": "normal",                     // "normal" | "half" | "almost"
          "commands": "off",                      // "off" | "on"
          "damage": "on"                          // "off" | "on"
        },
        "battle_mechanics": {
          "chakra": 0.5,                          // "normal" | "unlimited" | decimal 0.1..10 (step 0.1, %/s)
          "ultimate_jutsu": "no_hud",             // "no_use" | "random" | "command" | "timing" | "turn" | "combo" | "no_contest" | "no_hud"
          "shadowblur": "off",                    // "off" | "on"
          "extra_hit": "off",                     // "off" | "on" | int -100..-5 (step 5, % chakra penalty)
          "sub_active_frames": 5,                 // "default" | int 1..15 (total frames)
          "xdash_chakra_cost": 5,                 // int 0..100 (step 5, % chakra)
          "support": "off",                       // "off" | "nerfed" | "normal" | "unlimited"
          "substitution": {
            "value": "gauge",                     // "chakra" | "gauge" | "free"
            "chakra": {
              "minimum_chakra": "match_cost"       // "match_cost" | int 5..100 (step 5, % chakra)
            },
            "gauge": {
              "recovery_delay_seconds": 14.0,     // decimal 0..60 (step 0.25, seconds)
              "refill_seconds_per_stock": 1.0,    // decimal >0..10 (step 0.05, seconds)
              "damage_recovery": true,
              "damage_percent_per_stock": 31.25   // decimal >0..100 (step 0.25, %)
            }
          },
          "items": {
            "value": "custom",                    // "none" | "less" | "normal" | "more" | "custom"
            "custom": {
              "availability": "normal",           // "none" | "less" | "normal" | "more"
              "health_recovery": true,
              "chakra_ball": true,
              "shoes_of_jonin": true,
              "food_pills": true,
              "scroll_of_hidden_cloud": true,
              "scroll_of_teleportation": true,
              "scarecrow": true,
              "tortoiseshell_pills": true,
              "energy_pills": true,
              "medical_pack": true,
              "item_pouch": true,
              "demon_wind_shuriken": true,
              "weight_of_determination": true,
              "exploding_kunai": true,
              "poison_smoke_bomb": true,
              "makibishi_spikes": true,
              "paper_bomb": true,
              "curse_tag_chakra_points_seal": true,
              "curse_tag_armor_break": true,
              "thousand_shadow_shuriken": true,
              "burst_kunai": true,
              "exploding_seal": true,
              "toad_oil": true,
              "random_ball": true,
              "stun_ball": true
            }
          }
        }
      }
    },
    "general": {
      "replace_imported_game_title": true,
      "unlock_all": {
        "demon_wind_bomb": true
      }
    },
    "memory_card": {
      "display_only_first_save": true,
      "dedicated_save_namespace": true,
      "replace_memory_card_title": true
    },
    "startup": {
      "faster_loading": true,
      "skip_initial_memory_card_check": true,
      "auto_loading": true,
      "loading_screen": true
    },
    "character_select": {
      "balance_overlay": true,
      "support_selection": "all"                  // "all" | "relevant" | "none"
    },
    "mode_select": {
      "remove_adventure": true,
      "remove_shop": true
    },
    "rendering": {
      "native_16_9_horizontal_scale": false
    },
    "localization": {
      "font": {
        "glyphs": true,
        "layout": true,
        "numeric_formatting": true
      },
      "ui": true,
      "regional_input": true,
      "strings": true
    }
  }
}
