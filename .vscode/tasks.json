{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Injection Lab: Build only",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\injection_lab\\test.ps1",
        "-BuildOnly"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Injection Lab: Remove test",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\injection_lab\\test.ps1",
        "-Remove"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Injection Lab: Watch test C",
      "type": "shell",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\injection_lab\\watch.ps1",
        "-SourcePath",
        "${workspaceFolder}\\injection_lab\\src\\test.c"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "Injection Lab: Watch production Font",
      "type": "shell",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\injection_lab\\watch.ps1",
        "-SourcePath",
        "${workspaceFolder}\\na2_patcher\\features\\localization\\runtime_injector\\sources\\font_v2_core.c",
        "-ProductionEntry",
        "${input:fontProductionEntry}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "fontProductionEntry",
      "type": "pickString",
      "description": "Production Font entry to hot reload",
      "options": [
        "localization.font.v2.controls_adapter",
        "localization.font.v2.command_title_entry",
        "localization.font.v2.practice_title_entry",
        "localization.font.v2.pause_list_adapter",
        "localization.font.v2.quit_unselected_adapter",
        "localization.font.v2.quit_body_adapter",
        "localization.font.v2.special_controls_body_adapter"
      ],
      "default": "localization.font.v2.controls_adapter"
    }
  ]
}
