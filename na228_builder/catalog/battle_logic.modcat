{
  description: "Runtime-proven battle behavior and substitution settings.",
  disable_shadowblur_extra_hit: setting {
    description: "Shadowblur extra-hit behavior.",
    patches: [
      "e__battle_logic__disable_shadowblur_extra_hit__change_condition_branch",
      "e__battle_logic__disable_shadowblur_extra_hit__clear_branch_delay_slot",
      "e__battle_logic__disable_shadowblur_extra_hit__skip_path",
    ],
  },
  disable_extra_hit_with_aura_punishment_for_initiator: setting {
    description: "Extra-hit and aura-punishment behavior.",
    patches: [
      "e__battle_logic__disable_extra_hit_with_aura_punishment_for_initiator__retain_aura_punishment",
    ],
  },
  substitution_cost: setting<decimal & 0..15 & step 0.25> {
    description: "Substitution cost setting.",
    patches: [
      "e__battle_logic__substitution_cost",
    ],
  },
}
