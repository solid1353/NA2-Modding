patch=1,EE,003D0C70,word,00000000 // nop

// Suppress the remaining logo sequence after the normal English text load.
patch=1,EE,001E6620,word,00000000 // nop the branch into logo playback

// Enter the title state after required startup loaders, select Continue, map every
// no-load result to normal menu continuation, and suppress the Save/Load child draw.
patch=1,EE,001E6DB4,word,24030003 // li v1,3
