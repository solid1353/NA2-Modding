[+Practice bootstrap]
// Requires the normal PNACH's automatic-startup section. Its language-selector
// stub makes the remaining 0x003D0E40..0x003D0FFF tail resident and unreachable.
// Route successful Continue startup into the native Practice controller.
patch=1,EE,001EFA28,word,24020004 // li v0,4
patch=1,EE,001EFA2C,word,AE020008 // sw v0,8(s0)
patch=1,EE,001EFA30,word,24020003 // li v0,3
patch=1,EE,001EFA34,word,10000029 // retain the native branch
patch=1,EE,001EFA38,word,AE02000C // sw v0,12(s0)

// Replace only the state-7 Character Select and state-15 battle-update calls.
