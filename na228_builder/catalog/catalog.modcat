{
  features: {
    settings: {
      description: "In-game settings menus and shared defaults.",
      controls: setting {
        description: "Expose Guard and Substitution as independent remappable actions and default both players to L1 Substitution, R1 Guard, L2 Item Select, and R2 Linked Attack.",
        patches: [
          "e__battle__control_settings_rework",
          "i__battle__control_settings_rework",
        ],
      },
      practice: setting<{
        health?: "full" | "half" | "critical",
        commands?: "off" | "on",
        guide_ninja_sound?: "off" | "on",
        linked_attack?: "off" | "on" | "random",
      }> {
        description: "Own the compact native Practice Settings menu and optionally configure its Health, Commands, Guide Ninja Sound, and Linked Attack defaults; expose every shared runtime selector.",
        patches: [
          "i__practice__settings_rework",
        ],
      },
      shared: setting<{
        ultimate_jutsu: "no_use" | "random" | "command" | "timing" | "turn" | "combo" | "no_contest" | "no_hud",
        shadowblur: "off" | "on",
        extra_hit: "off" | "on",
        sub_active_frames: int & 0..16,
        xdash_chakra_cost: int & 0..100 & step 5,
        support: "off" | "on",
        simple_display: "off" | "on",
        substitution: {
          default: "chakra" | "gauge" | "free",
          recovery_delay_seconds?: decimal & 0..60 & step 0.25,
          refill_seconds_per_stock?: decimal & >0 & <=10 & step 0.05,
          damage_recovery?: bool,
          damage_percent_per_stock?: decimal & >0 & <=100 & step 0.25,
        },
      }> {
        description: "Install the shared Ultimate Jutsu, Shadowblur Extra Hit, Extra Hit, pre-impact Substitution input-window, X-dash chakra-cost, Support, and Substitution selectors in Battle Settings and Practice Settings, choose their initial and reset values, and choose the initial Simple Display value. No Contest suppresses contest inputs and UI while retaining its lifecycle; No HUD includes No Contest and hides the complete battle HUD through the native transition. Gauge uses the configured recovery behavior and requires Character Overrides.",
        patches: [
          "e__battle__simple_display",
          "i__battle__settings_rework",
          "i__battle__support",
          "i__battle_logic__sub_active_frames",
          "i__battle_logic__settings",
          "i__battle_logic__substitution__gauge",
          "i__battle_logic__xdash_chakra_cost",
        ],
      },
    },
    general: {
      character_overrides: setting {
        description: "Load layered per-character battle overrides.",
        patches: [
          "i__battle_logic__character_overrides",
        ],
      },
      unlock_all: setting {
        description: "Expose the characters, supports, stages, jutsu, Shop items, and Collection entries present in a fully unlocked save without changing saved progress, currency, inventory, or settings.",
        patches: [
          "i__qol__content__unlock_all__demon_wind_bomb",
          "i__qol__content__unlock_all__availability",
        ],
      },
      replace_imported_game_title: setting {
        description: "Replace the imported NUN5 game title with the NA228 product title.",
        patches: [
          "s__general__replace_imported_game_title",
        ],
      },
    },
    memory_card: {
      display_only_first_save: setting {
        description: "Select record zero directly in Save and Load flows while retaining the native memory-card scan, confirmation, load/save operations, and non-record status handling; No completes without reopening the removed record list.",
        patches: [
          "e__qol__save_load__display_only_first_save",
          "i__qol__save_load__display_only_first_save",
        ],
      },
      dedicated_save_namespace: setting {
        description: "Use a dedicated NA228 save namespace instead of sharing the original NA2 save namespace.",
        patches: [
          "e__general__dedicated_save_namespace__directory_references",
        ],
      },
      replace_memory_card_title: setting {
        description: "Replace the original memory-card title with the NA228 title.",
        patches: [
          "e__general__replace_memory_card_title",
        ],
      },
    },
    startup: {
        faster_loading: setting {
          description: "Shorten startup by loading RPG and player voice-bank indexes only when each bank is first played.",
          startup_fast_forward_frames: {
            additive: -600,
          },
          patches: [
            "i__qol__startup__faster_loading__lazy_voice_indexes",
          ],
        },
        flow: {
          description: "Retain the native title path with independent optional skips for its preceding sequences.",
          skip_cc2_intro: setting {
            description: "Skip the CyberConnect2 intro.",
            patches: [
              "e__qol__startup__skip_cc2_intro__skip_cc2_intro",
            ],
          },
          skip_opening: setting {
            description: "Skip the opening sequence.",
            patches: [
              "e__qol__startup__skip_opening__skip_opening",
            ],
          },
        }
        |
        {
          description: "Replace the boot presentation and route directly through the startup Save/Load path.",
          savedata_loading: setting<"manual"> {
            description: "Retain the native visible Save/Load flow; no-load completion proceeds to the main menu.",
            patches: [
              "e__qol__startup__save_loading__core",
            ],
          }
          |
          setting<"automatic"> {
            description: "Silently load record zero when it exists, and otherwise proceed to the main menu without showing Save/Load UI or requiring input. Report the outcome in black for ten seconds in the top-right corner of the usable menu; successful loads also show play time and the saved date/time.",
            patches: [
              "e__qol__startup__save_loading__core",
              "e__qol__startup__save_loading__automatic__suppress_save_load_draw",
              "i__qol__startup__save_loading__automatic__first_save",
            ],
          },
          loading_screen: setting {
            description: "Replace the boot splashes with a large primitive percentage and progress bar paced across a 6.5-second elapsed-time estimate while the original startup loaders run.",
            patches: [
              "i__qol__startup__loading_screen__runtime",
            ],
          },
        },
    },
    character_select: {
        description: "Character Select behavior and overlays.",
        balance_overlay: setting {
          description: "Show each side's character tier on Character Select and include resolved substitution cost only when Character Overrides is enabled.",
          patches: [
            "i__battle_logic__character_select_balance_overlay",
          ],
        },
        support_selection_rework: setting {
          description: "Build compact per-character support lists defaulting to No Support without wrapping across list edges and retain selected supports for linked Jutsu without changing battle support availability.",
          patches: [
            "i__character_select__support_selection_rework",
          ],
        },
    },
    mode_select: {
        description: "Mode availability and selection behavior.",
        remove_adventure: setting {
          description: "Omit Adventure from Mode Select using the NUN6 negative availability sentinel.",
          patches: [
            "e__qol__mode_select__remove_adventure__mark_entry_unavailable_matching_nun6",
          ],
        },
        remove_shop: setting {
          description: "Omit Shop from Mode Select using the same negative availability sentinel as the Adventure omission.",
          patches: [
            "e__qol__mode_select__remove_shop__mark_entry_unavailable_using_existing",
          ],
        },
    },
    rendering: {
      description: "Game-wide rendering and output geometry.",
      native_16_9_horizontal_scale: setting {
        description: "Force the renderer's horizontal-scale field to 0.75 through its object pointer.",
        patches: [
          "e__rendering__native_16_9_horizontal_scale__force_0",
        ],
      },
    },
    localization: {
      font: {
        description: "English font rendering and formatting.",
        glyphs: setting {
          description: "Use the English glyph atlas, packed metrics, and renderer geometry.",
          patches: [
            "e__localization__font__glyphs",
            "i__localization__font__glyphs__metrics",
            "i__localization__shared_font_payload",
          ],
        },
        layout: setting {
          description: "Apply English text measurement, fitting, wrapping, selected styling, and screen-specific layout.",
          patches: [
            "e__localization__font__layout",
            "i__localization__font__layout__character_select_modal",
            "i__localization__font__layout__collection_confirmation",
            "i__localization__font__layout__collection_lists",
            "i__localization__font__layout__command_relationships",
            "i__localization__font__layout__controls",
            "i__localization__font__layout__core",
            "i__localization__font__layout__global_selected_style",
            "i__localization__font__layout__jutsu_selector",
            "i__localization__font__layout__mode_select_confirmation",
            "i__localization__font__layout__ninja_song_details",
            "i__localization__font__layout__pause_controls",
            "i__localization__font__layout__practice_explanations",
            "i__localization__font__layout__quit_confirmation",
            "i__localization__font__layout__runtime",
            "i__localization__font__layout__settings_rows",
            "i__localization__font__layout__special_controls_body",
            "i__localization__font__layout__titles",
            "i__localization__shared_font_payload",
          ],
        },
        numeric_formatting: setting {
          description: "Format dynamic numbers with the English renderer conventions.",
          patches: [
            "e__localization__font__numeric_formatting__save_load_separator",
            "i__localization__font__numeric_formatting__battle_settings",
            "i__localization__font__numeric_formatting__ninja_song",
            "i__localization__font__numeric_formatting__save_load",
            "i__localization__shared_font_payload",
          ],
        },
      },
      ui: setting {
        description: "Apply matching English UI textures, rectangles, anchors, scaling, and screen-specific geometry.",
        modules: [
          "texture_patcher",
        ],
        patches: [
          "e__localization__ui_layout__common_prompt_anchors",
          "e__localization__ui_layout__battle_hud_name_rectangles",
          "e__localization__ui_layout__command_chart_header",
          "e__localization__ui_layout__battle_hud_names",
          "e__localization__ui_layout__battle_results",
          "e__localization__ui_layout__character_select",
          "e__localization__ui_layout__collection_submenu",
          "e__localization__ui_layout__command_scroll_arrows",
          "e__localization__ui_layout__options",
          "e__localization__ui_layout__item_status_paired",
          "e__localization__ui_layout__mash_prompts",
          "e__localization__ui_layout__mode_select",
          "e__localization__ui_layout__practice_settings_prompt",
          "e__localization__ui_layout__record_tables",
          "e__localization__ui_layout__round_label",
          "e__localization__ui_layout__stage_select",
          "e__localization__ui_layout__ultimate_jutsu_label",
          "e__localization__ui_layout__vs_confirmation",
          "i__localization__ui_layout__command_chart_header",
          "i__localization__ui_layout__runtime",
          "i__localization__shared_font_payload",
        ],
      },
      regional_input: setting {
        description: "Apply regional confirm, cancel, navigation, and related menu-input behavior consistently across the game.",
        patches: [
          "e__localization__regional_input",
          "i__localization__shared_font_payload",
        ],
      },
    },
  },
}
