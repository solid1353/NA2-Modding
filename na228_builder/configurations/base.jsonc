{
  "features": {
    "localization": "en",                                   // "en" | "jp" (experimental: some custom graphics and controls do not work correctly)
    "general": {                                            // object | false
      "music_override": true,
      "practice_stage_select": true,
      "stage_selection_persistence": true,
      "battle_results_rematch": true,
      "unlock_all": {                                       // object | false
        "demon_wind_bomb": true
      },
      "mode_availability": {                                // object | false
        "remove_adventure": true,
        "remove_shop": true
      }
    },
    "startup": {                                            // object | false
      "faster_loading": true,
      "loading_screen": true
    },
    "memory_card": {                                        // object | false
      "auto_loading": true,                                 // false: works, but is not fully supported or tested
      "dialogs_rework": true,
      "skip_initial_check": true,
      "extended_save_data": true
    },
    "rendering": {                                          // object | false
      "native_16_9_horizontal_scale": false                 // true: experimental; the interface does not scale properly
    },
    "defaults": {
      "mod_settings": {
        "match_setup_submenu": true,
        "battle_mechanics_submenu": true,
        "battle_settings_submenu": true,
        "practice_settings_submenu": true,
        "control_settings_submenu": true,
        "simple_display": "off"                             // "off" | "on"
      },
      "match_setup": {
        "support_selection": "none",                        // "none" | "relevant" | "all"
        "character_balance": "overrides",                   // "original" | "overrides"
        "balance_overlay": "on",                            // "off" | "on"
        "extended_items": "on"                              // "off" | "on"
      },
      "battle_mechanics": {
        "chakra": "normal",                                 // "normal" | "unlimited" | decimal 0.1..10 (step 0.1, %/s)
        "ultimate_jutsu": "no_hud",                         // "no_use" | "random" | "command" | "timing" | "turn" | "combo" | "no_contest" | "no_hud"
        "shadowblur": "off",                                // "off" | "on"
        "extra_hit": "off",                                 // "off" | "on" | int -100..-5 (step 5, % chakra penalty)
        "xdash_chakra_cost": 10,                            // int 0..100 (step 5, % chakra)
        "support": "off",                                   // "off" | "nerfed" | "normal" | "unlimited"
        "substitution_input": "hold",                       // "default" | "hold" | int 1..15 (total frames)
        "substitution_resource": {
          "value": "gauge",                                 // "chakra" | "gauge" | "free"
          "chakra": {
            "minimum_chakra": "match_cost"                  // "match_cost" | int 5..100 (step 5, % chakra)
          },
          "gauge": {
            "recovery_delay_seconds": 15.0,                 // decimal 0..60 (step 0.25, seconds)
            "refill_seconds_per_stock": 5.0,                // decimal >0..10 (step 0.05, seconds)
            "damage_recovery": "on",                        // "off" | "on"
            "damage_percent_for_full_refill": 150           // integer 5..400 (step 5, %)
          }
        },
        "items": {
          "value": "custom",                                // "none" | "less" | "normal" | "more" | "custom"
          "custom": {
            "availability": "normal",                       // "none" | "less" | "normal" | "more"
            "health_recovery": "on",                        // "off" | "on"
            "chakra_ball": "on",                            // "off" | "on"
            "shoes_of_jonin": "on",                         // "off" | "on"
            "food_pills": "on",                             // "off" | "on"
            "scroll_of_hidden_cloud": "on",                 // "off" | "on"
            "scroll_of_teleportation": "on",                // "off" | "on"
            "scarecrow": "on",                              // "off" | "on"
            "tortoiseshell_pills": "on",                    // "off" | "on"
            "energy_pills": "on",                           // "off" | "on"
            "medical_pack": "on",                           // "off" | "on"
            "item_pouch": "on",                             // "off" | "on"
            "demon_wind_shuriken": "on",                    // "off" | "on"
            "weight_of_determination": "on",                // "off" | "on"
            "exploding_kunai": "on",                        // "off" | "on"
            "poison_smoke_bomb": "on",                      // "off" | "on"
            "makibishi_spikes": "on",                       // "off" | "on"
            "paper_bomb": "on",                             // "off" | "on"
            "curse_tag_chakra_points_seal": "on",           // "off" | "on"
            "curse_tag_armor_break": "on",                  // "off" | "on"
            "thousand_shadow_shuriken": "on",               // "off" | "on"
            "burst_kunai": "on",                            // "off" | "on"
            "exploding_seal": "on",                         // "off" | "on"
            "toad_oil": "on",                               // "off" | "on"
            "random_ball": "on",                            // "off" | "on"
            "stun_ball": "on"                               // "off" | "on"
          }
        }
      },
      "battle_settings": {
        "battle_mechanics_submenu": true,
        "time": 99,                                         // int 10..90 (step 10) | 99 | "unlimited"
        "difficulty": "normal",                             // "simple" | "easy" | "normal" | "hard" | "insane" | "ultimate"
        "handicap": 5                                       // int 0..10 (Player 1; Player 2 is 10 minus this value)
      },
      "practice_settings": {
        "battle_mechanics_submenu": true,
        "opponent_settings": {
          "status": "manual",                               // "manual" | "com" | "stand" | "jump" | "double_jump"
          "strength": "normal",                             // "simple" | "easy" | "normal" | "hard" | "insane" | "ultimate"
          "attack": "no",                                   // "no" | "single" | "combo" | "projectile" | "high_speed_move" | "ultimate_jutsu" | "jutsu"
          "guard": "no",                                    // "no" | "yes"
          "move": "stay",                                   // "stay" | "follow"
          "substitution_jutsu": "normal",                   // "normal" | "no"
          "linked_attack": "dont_use",                      // "dont_use" | "normal" | "random"
          "extra_hit_counter": "normal"                     // "normal" | "return"
        },
        "health": "normal",                                 // "normal" | "half" | "almost"
        "commands": "off",                                  // "off" | "on"
        "damage": "on"                                      // "off" | "on"
      },
      "control_settings": {                                 // "attack" | "ultimate_jutsu_prep" | "item_use" | "jump" | "substitution" | "guard" | "item_select_l" | "item_select_r" | "linked_attack" | "unbound"
        "circle": "attack",
        "triangle": "ultimate_jutsu_prep",
        "square": "item_use",
        "cross": "jump",
        "select": "unbound",
        "l1": "substitution",
        "r1": "guard",
        "l2": "item_select_l",
        "r2": "item_select_r",
        "l3": "unbound",
        "r3": "linked_attack",
        "vibration": "off"                                  // "off" | "on"
      }
    }
  }
}
