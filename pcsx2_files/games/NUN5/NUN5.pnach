[+Select No Support on Character Select]
// NUN5-native NA228 behavior; 0x2000 bytes are reserved from the
// allocator tail before any payload or hook write can execute.
patch=2,EE,20118D6C,extended,2616E000 // boot+vsync: addiu s6,s0,-0x2000
// qol.character.select.no.support.bss.qol.character.select.no.support.buffers @ 0x01FF4A60 (2216 bytes): mutable, never written by PNACH.
// Each block is inert until allocator initialization publishes the
// reserved heap end 0x01FF3FF0 at 0x00617A84. This also makes hot
// reload safe for an already-running native-heap process.
patch=1,EE,D0617A84,extended,FF003FF0 // heap-end low16 == 0x3FF0
patch=1,EE,21FF4000,extended,27BDFFD0 // qol.character.select.no.support.text (296 bytes)
