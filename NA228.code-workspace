{
  "folders": [
    {
      "name": "NA2 Modding",
      "path": "."
    },
    {
      "name": "UN Workshop",
      "path": "../UN Workshop"
    },
    {
      "name": "Codex Utils",
      "path": "../../codex-utils"
    },
    {
      "name": "PCSX2",
      "path": "../../PCSX2"
    }
  ],
  "settings": {
    "git.scanRepositories": [
      "e2e/captures"
    ],
    "files.eol": "\n",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "C_Cpp.errorSquiggles": "disabled",
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
      "**/.gitkeep": true,
      "**/__pycache__": true,
      "**/__init__.py": true
    },
    "search.exclude": {
      "**/.gitkeep": true,
      "**/__pycache__": true,
      "**/__init__.py": true
    },
    "files.watcherExclude": {
      "**/__pycache__/**": true
    },
    "powershell.cwd": "NA2 Modding"
  }
}
